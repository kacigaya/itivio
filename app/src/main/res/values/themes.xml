<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Compose draws everything; this theme only covers the window before the first frame. -->
    <style name="Base.Theme.Itivio" parent="android:Theme.Material.Light.NoActionBar" />

    <!-- The window has the surface color of the app, so the first frame does not flash white. -->
    <style name="Theme.Itivio" parent="Base.Theme.Itivio">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
